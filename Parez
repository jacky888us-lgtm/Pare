EggLite.lua  -  lightweight egg viewer + selective auto steal (Luau, executor environment)

STATUS: not run in-game. Every game-specific value below is nil (= UNSET) on purpose.
Nothing here was taken from the ChilliFinder script: that file is only a Luarmor loader.
Fill Config from the Probe output, then verify each feature in the live game.

Sources:
  told by user : wants egg contents + price viewer, per-egg auto steal, anti-guard,
                 teleport-steal + teleport back to base, auto event
  assumed      : eggs are Instances (Model/BasePart) under one container; steal is either a
                 ProximityPrompt or a RemoteEvent/RemoteFunction (Config.Steal.Mode decides)
  missing      : every path, attribute name, remote name, guard matcher, event routine
]]

------------------------------------------------------------------ CONFIG
local Config = {
    Build = nil,            -- free-text note of the game build/date you verified against
    PlaceId = nil,          -- number; if set, script refuses to run in any other place

    Eggs = {
        Root = nil,         -- path table, e.g. {"Workspace", "<container>"}; UNSET
        IsEgg = nil,        -- optional function(inst) -> boolean; default: every direct child of Root
        Contents = nil,     -- field spec for contents text: {attr="..."} or {child="..."}; UNSET
        Price = nil,        -- field spec for price:         {attr="..."} or {child="..."}; UNSET
        Owner = nil,        -- field spec for owner (name or UserId, string/number); UNSET
        RefreshSeconds = 1, -- viewer refresh period
    },

    Steal = {
        Mode = nil,         -- "prompt" or "remote"; UNSET
        PromptName = nil,   -- optional ProximityPrompt name inside the egg (prompt mode)
        Remote = nil,       -- path table to RemoteEvent/RemoteFunction (remote mode)
        BuildArgs = nil,    -- function(egg) -> ... args for the remote (remote mode)
        ReturnDelay = 0.05, -- seconds between trigger and teleport back. UNCALIBRATED
        TeleportOffset = Vector3.new(0, 3, 0), -- offset above the egg pivot. UNCALIBRATED
    },

    Guard = {
        Root = nil,         -- path table to the container holding guards; UNSET
        Match = nil,        -- function(inst) -> boolean, true for a guard model/part; UNSET
        Radius = nil,       -- studs; eggs with a guard closer than this are skipped; UNSET
        NeutralizeTouch = false, -- client-side CanTouch=false on guard parts; unverified effect
    },

    Event = {
        Run = nil,          -- function() performing one auto-event action; UNSET
        Interval = 1,       -- seconds between Run calls
    },
}

------------------------------------------------------------------ PURE HELPERS
-- "$1,250" -> 1250, "3.5K" -> 3500, "2M" -> 2000000; nil if not parseable
local function parsePrice(v)
    if type(v) == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return nil end
        return v
    end
    if type(v) ~= "string" then return nil end
    local s = v:gsub(",", ""):gsub("%s", "")
    local num, suffix = s:match("(%d+%.?%d*)([KkMmBbTt]?)")
    if not num then return nil end
    local n = tonumber(num)
    if not n then return nil end
    local mult = ({k = 1e3, m = 1e6, b = 1e9, t = 1e12})[suffix:lower()] or 1
    return n * mult
end

local function formatPrice(n)
    if not n then return "?" end
    local units = {{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}
    for _, u in ipairs(units) do
        if n >= u[1] then return string.format("%.2f%s", n / u[1], u[2]) end
    end
    return tostring(math.floor(n))
end

local function resolvePath(path)
    if type(path) ~= "table" then return nil end
    local cur = game
    for _, name in ipairs(path) do
        if typeof(cur) ~= "Instance" then return nil end
        cur = cur:FindFirstChild(name)
        if not cur then return nil end
    end
    return cur
end

local function readField(inst, spec)
    if not spec or not inst then return nil end
    if spec.attr then return inst:GetAttribute(spec.attr) end
    if spec.child then
        local c = inst:FindFirstChild(spec.child)
        if not c then return nil end
        local ok, val = pcall(function() return c.Value end)
        if ok then return val end
        local ok2, txt = pcall(function() return c.Text end)
        if ok2 then return txt end
    end
    return nil
end

local function pivotPosition(inst)
    local ok, cf = pcall(function() return inst:GetPivot() end)
    if not ok or typeof(cf) ~= "CFrame" then return nil end
    local p = cf.Position
    if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return nil end -- NaN
    if math.abs(p.X) > 1e6 or math.abs(p.Y) > 1e6 or math.abs(p.Z) > 1e6 then return nil end
    return p, cf
end

