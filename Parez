    State.alive = false
    State.autoSteal, State.antiGuard, State.autoEvent = false, false, false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    pcall(function() gui:Destroy() end)
    if getgenv then getgenv().__EggLiteUnload = nil end
end
