-- rows are rebuilt only when the snapshot changes in a way the user can see
local rows = {}
local lastSig = ""
local function rebuildRows()
    local sig = {}
    for _, e in ipairs(State.eggs) do
        sig[#sig + 1] = tostring(e.inst) .. "|" .. tostring(e.contents) .. "|" .. tostring(e.price) .. "|" .. tostring(e.owner)
            .. "|" .. tostring(State.selected[e.inst])
    end
    local s = table.concat(sig, ";")
    if s == lastSig then return end
    lastSig = s
    for _, r in ipairs(rows) do r:Destroy() end
    table.clear(rows)
    for _, e in ipairs(State.eggs) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -6, 0, 38)
        row.BackgroundColor3 = State.selected[e.inst] and Color3.fromRGB(40, 90, 120) or Color3.fromRGB(34, 34, 42)
        row.BorderSizePixel = 0
        row.Font = Enum.Font.Gotham
        row.TextSize = 11
        row.TextColor3 = e.mine and Color3.fromRGB(130, 130, 140) or Color3.new(1, 1, 1)
        row.TextWrapped = true
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.Text = string.format("%s%s  |  %s\nPrice: %s  |  Owner: %s",
            State.selected[e.inst] and "[x] " or "[ ] ", e.name,
            e.contents ~= nil and tostring(e.contents) or "contents ?",
            formatPrice(e.price), e.owner ~= nil and tostring(e.owner) or "?")
        row.Parent = list
        local egg = e
        row.MouseButton1Click:Connect(function()
            State.selected[egg.inst] = (not State.selected[egg.inst]) or nil
            lastSig = ""
        end)
        rows[#rows + 1] = row
    end
end

