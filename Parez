------------------------------------------------------------------ EGG SNAPSHOT
local function isMine(ownerValue)
    if ownerValue == nil then return false end
    if type(ownerValue) == "number" then return ownerValue == LocalPlayer.UserId end
    local s = tostring(ownerValue)
    return s == LocalPlayer.Name or s == LocalPlayer.DisplayName or s == tostring(LocalPlayer.UserId)
end

local function snapshotEggs()
    local root = resolvePath(Config.Eggs.Root)
    local out = {}
    if not root then State.eggs = out; return end
    local count = 0
    for _, inst in ipairs(root:GetChildren()) do
        count += 1
        if count > 500 then break end -- bound the loop
        if not Config.Eggs.IsEgg or Config.Eggs.IsEgg(inst) then
            local owner = readField(inst, Config.Eggs.Owner)
            out[#out + 1] = {
                inst = inst,
                name = inst.Name,
                contents = readField(inst, Config.Eggs.Contents),
                price = parsePrice(readField(inst, Config.Eggs.Price)),
                owner = owner,
                mine = isMine(owner),
            }
        end
    end
    table.sort(out, function(a, b) return (a.price or -1) > (b.price or -1) end)
    State.eggs = out
end

------------------------------------------------------------------ GUARDS
local function nearGuard(pos)
    if not (Config.Guard.Match and Config.Guard.Radius) then return false end
    local root = resolvePath(Config.Guard.Root)
    if not root then return false end
    for _, inst in ipairs(root:GetChildren()) do
        if Config.Guard.Match(inst) then
            local gp = pivotPosition(inst)
            if gp and (gp - pos).Magnitude <= Config.Guard.Radius then return true end
        end
    end
    return false
end

local function neutralizeGuards()
    if not (Config.Guard.NeutralizeTouch and Config.Guard.Match) then return end
    local root = resolvePath(Config.Guard.Root)
    if not root then return end
    for _, inst in ipairs(root:GetChildren()) do
        if Config.Guard.Match(inst) then
            for _, d in ipairs(inst:GetDescendants()) do
                if d:IsA("BasePart") and d.CanTouch then d.CanTouch = false end
            end
        end
    end
end

------------------------------------------------------------------ STEAL
local function trigger(egg)
    local mode = Config.Steal.Mode
    if mode == "prompt" then
        if not fireproximityprompt then return false, "executor has no fireproximityprompt" end
        local prompt
        if Config.Steal.PromptName then
            prompt = egg:FindFirstChild(Config.Steal.PromptName, true)
        else
            for _, d in ipairs(egg:GetDescendants()) do
                if d:IsA("ProximityPrompt") then prompt = d; break end
            end
        end
        if not prompt then return false, "no ProximityPrompt on egg" end
        prompt.HoldDuration = 0 -- local only; server may still enforce its own hold time
        fireproximityprompt(prompt)
        return true
    elseif mode == "remote" then
        local remote = resolvePath(Config.Steal.Remote)
        if not remote then return false, "Steal.Remote path did not resolve" end
        if not Config.Steal.BuildArgs then return false, "Steal.BuildArgs unset" end
        local args = table.pack(Config.Steal.BuildArgs(egg))
        if remote:IsA("RemoteEvent") then
            remote:FireServer(table.unpack(args, 1, args.n))
        elseif remote:IsA("RemoteFunction") then
            task.spawn(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end)
        else
            return false, "Steal.Remote is not a Remote"
        end
        return true
    end
    return false, "Steal.Mode unset"
end

local function stealOne(entry)
    if State.busy then return false, "busy" end
    if not State.base then return false, "base not saved" end
    local _, hrp = character()
    if not hrp then return false, "no character" end
    local egg = entry.inst
    if not egg or not egg.Parent then return false, "egg gone" end
    local pos = pivotPosition(egg)
    if not pos then return false, "egg position invalid" end
    if State.antiGuard and nearGuard(pos) then return false, "guard near" end

    State.busy = true
    local ok, err = pcall(function()
        hrp.CFrame = CFrame.new(pos + Config.Steal.TeleportOffset)
        local fired, why = trigger(egg)
        if not fired then error(why, 0) end
        if Config.Steal.ReturnDelay > 0 then task.wait(Config.Steal.ReturnDelay) end
    end)
    -- always go back to base, even if the trigger failed
    local _, hrp2 = character()
    if hrp2 then hrp2.CFrame = State.base end
    State.busy = false
    if not ok then return false, tostring(err) end
    return true
end

local function autoStealLoop()
    while State.alive do
        if State.autoSteal and not State.busy then
            for _, e in ipairs(State.eggs) do
                if not State.alive or not State.autoSteal then break end
                if State.selected[e.inst] and not e.mine and e.inst.Parent then
                    local ok, why = stealOne(e)
                    if not ok and why ~= "guard near" then
                        warn("[EggLite] steal skipped: " .. tostring(why))
                        task.wait(0.5) -- avoid spamming a persistent failure
                    end
                end
            end
        end
        task.wait()
    end
end

------------------------------------------------------------------ PROBE (fills the config)
local function probe()
    local lines = {"[EggLite probe] PlaceId=" .. game.PlaceId}
    local kw = {"egg", "steal", "event", "claim", "guard", "grab"}
    local function hit(n)
        n = n:lower()
        for _, k in ipairs(kw) do if n:find(k, 1, true) then return true end end
        return false
    end
    local scanned = 0
    for _, root in ipairs({workspace, game:GetService("ReplicatedStorage")}) do
        for _, d in ipairs(root:GetDescendants()) do
            scanned += 1
            if scanned > 20000 then break end
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                lines[#lines + 1] = "REMOTE  " .. d:GetFullName()
            elseif d:IsA("ProximityPrompt") and d.Parent and hit(d.Parent.Name) then
                lines[#lines + 1] = "PROMPT  " .. d:GetFullName() .. "  Hold=" .. d.HoldDuration
            elseif (d:IsA("Model") or d:IsA("BasePart")) and hit(d.Name) then
                local attrs = {}
                for k, v in pairs(d:GetAttributes()) do attrs[#attrs + 1] = k .. "=" .. tostring(v) end
                local kids = {}
                for _, c in ipairs(d:GetChildren()) do
                    if c:IsA("ValueBase") then kids[#kids + 1] = c.Name .. "(" .. c.ClassName .. ")" end
                end
                lines[#lines + 1] = "CANDIDATE " .. d:GetFullName()
                    .. "  attrs[" .. table.concat(attrs, ", ") .. "]"
                    .. "  values[" .. table.concat(kids, ", ") .. "]"
            end
        end
    end
    local text = table.concat(lines, "\n")
    print(text)
    if setclipboard then pcall(setclipboard, text) end
    return #lines
end

